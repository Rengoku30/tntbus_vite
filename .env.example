# TNTBus environment variables (all optional — sane defaults apply).

# Probability (0..1) that a mock API call fails, to exercise the error UI.
# Example: 0.4 means ~40% of calls fail with a retryable server error.
VITE_API_FAILURE_RATE=0

# Artificial latency (ms) applied to mock API calls so loading states are visible.
VITE_API_LATENCY_MS=350

# Seat-hold lock TTL in milliseconds. When it expires the user is prompted
# to re-select their seats.
VITE_SEAT_LOCK_TTL_MS=300000

# Simulate occasional network timeouts in dev (true/false).
VITE_DEBUG_FAILURES=false
